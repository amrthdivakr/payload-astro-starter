---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreviewBar from '../components/PreviewBar.astro';
import type { PublicFooter, PublicNav } from '../lib/payload';

interface Props {
  title: string;
  nav: PublicNav;
  footer: PublicFooter;
  origin: string;
  /** Passed by the catch-all; overlay layouts use it for homepage-only chrome. */
  isHomepage?: boolean;
}

const { title, nav, footer, origin } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <PreviewBar />
    <Header nav={nav} origin={origin} />
    <main>
      <slot />
    </main>
    <Footer footer={footer} origin={origin} />
  </body>
</html>
