---
import type { PublicHtmlBlock } from '../lib/payload';

interface Props {
  block: PublicHtmlBlock;
  origin: string;
}

const { block, origin } = Astro.props;

// Imported file links are root-relative media URLs; serve them from Payload.
const payloadOrigin = origin.replace(/\/+$/, '');
const html =
  typeof block.html === 'string' && block.html.trim()
    ? block.html
        .trim()
        .replace(/\b(href|src)=(["'])\/api\/media\//gi, `$1=$2${payloadOrigin}/api/media/`)
    : undefined;
---

{html && <Fragment set:html={html} />}
