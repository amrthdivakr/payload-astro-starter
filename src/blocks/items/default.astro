---
import type { PublicItemsBlock, PublicLinkRow } from '../../lib/payload';
import ItemRows from '../../components/ItemRows.astro';
import {
  hrefFromLink,
  lexicalToHtml,
  linkLabel,
  linkOpensNewTab,
  textField,
} from '../../lib/content';

interface Props {
  block: PublicItemsBlock;
  origin: string;
}

const { block, origin } = Astro.props;
const { prefix } = Astro.locals;

function linkRows(rows: PublicLinkRow[] | null | undefined) {
  if (!rows?.length) return [];
  return rows
    .map((row) => {
      const label = linkLabel(row);
      const href = hrefFromLink(row, prefix);
      if (!label || !href) return null;
      return { label, href, newTab: linkOpensNewTab(row) };
    })
    .filter(Boolean);
}

const eyebrow = textField(block.eyebrow);
const heading = textField(block.heading);
const subheading = textField(block.subheading);
const contentHtml = lexicalToHtml(block.content, prefix);
const links = linkRows(block.links);

---

<section>
  {eyebrow && <p>{eyebrow}</p>}
  {heading && <h2>{heading}</h2>}
  {subheading && <p>{subheading}</p>}
  {contentHtml && <div set:html={contentHtml} />}
  {links.length > 0 && (
    <p>
      {links.map((link) =>
        link ? (
          <a
            href={link.href}
            target={link.newTab ? '_blank' : undefined}
            rel={link.newTab ? 'noreferrer' : undefined}
          >
            {link.label}
          </a>
        ) : null,
      )}
    </p>
  )}
  <ItemRows items={block.items} origin={origin} />
</section>
