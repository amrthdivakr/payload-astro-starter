---
import type { PublicHero, PublicLinkRow } from '../../lib/payload';
import {
  hrefFromLink,
  lexicalToHtml,
  linkLabel,
  linkOpensNewTab,
  mediaUrl,
  textField,
} from '../../lib/content';

interface Props {
  hero: PublicHero;
  origin: string;
}

const { hero, origin } = Astro.props;
const { prefix } = Astro.locals;

function mediaImages(
  items: PublicHero['media'],
  background: PublicHero['backgroundMedia'],
) {
  const all = [...(items ?? []), ...(background ?? [])];
  return all
    .map((item) => {
      if (!item || typeof item !== 'object') return null;
      const src = mediaUrl(item, origin);
      if (!src) return null;
      const alt =
        typeof item.alt === 'string' && item.alt.trim() ? item.alt.trim() : '';
      return { src, alt };
    })
    .filter(Boolean);
}

function linkRows(rows: PublicLinkRow[] | null | undefined) {
  if (!rows?.length) return [];
  return rows
    .map((row) => {
      const label = linkLabel(row);
      const href = hrefFromLink(row, prefix);
      if (!label || !href) return null;
      return { label, href, newTab: linkOpensNewTab(row) };
    })
    .filter(Boolean);
}

const eyebrow = textField(hero.eyebrow);
const heading = textField(hero.heading);
const subheading = textField(hero.subheading);
const contentHtml = lexicalToHtml(hero.content, prefix);
const images = mediaImages(hero.media, hero.backgroundMedia);
const links = linkRows(hero.links);
---

<section>
  {eyebrow && <p>{eyebrow}</p>}
  {heading && <h2>{heading}</h2>}
  {subheading && <p>{subheading}</p>}
  {contentHtml && <div set:html={contentHtml} />}
  {images.map((image) =>
    image ? <img src={image.src} alt={image.alt} /> : null,
  )}
  {links.length > 0 && (
    <p>
      {links.map((link) =>
        link ? (
          <a
            href={link.href}
            target={link.newTab ? '_blank' : undefined}
            rel={link.newTab ? 'noreferrer' : undefined}
          >
            {link.label}
          </a>
        ) : null,
      )}
    </p>
  )}
</section>
