---
import { PAYLOAD_URL } from 'astro:env/server';
import { getPublicDoc, getPublicSite } from '../lib/payload';
import type { PublicFetchOptions } from '../lib/payload';
import {
  findRedirectByFrom,
  normalizePath,
  redirectDestinationIfValid,
} from '../lib/match';
import {
  isMultiLocale,
  localePrefix,
  splitLocale,
  withPrefix,
} from '../lib/locale';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import RenderBlocks from '../blocks/RenderBlocks.astro';

const previewActive = Astro.cookies.get('payload-preview')?.value === '1';
const previewToken = Astro.cookies.get('payload-token')?.value ?? '';
const inPreview = previewActive && previewToken.length > 0;

const fetchOptions: PublicFetchOptions = inPreview
  ? { draft: true, token: previewToken }
  : {};

const pathname = normalizePath(Astro.url.pathname);

// Site in its default locale first: it gives the site's locale list.
const base = await getPublicSite(fetchOptions);

if (inPreview) {
  Astro.cache.set(false);
} else {
  Astro.cache.set({ maxAge: 3600, tags: ['payload'] });
}

const route = splitLocale(pathname, base.site);

if (!route) {
  // Multi-locale site, no locale prefix: a listed redirect first, else the
  // same path in the default locale (`/` → `/en`). An unknown prefix
  // (`/de/x`) goes the same way and ends as a 404 there.
  const defaultPrefix = localePrefix(base.site.defaultLocale, base.site);
  const redirect = findRedirectByFrom(base.redirects, pathname);
  const destination = redirect
    ? redirectDestinationIfValid(redirect, pathname, defaultPrefix)
    : undefined;
  return Astro.redirect(destination ?? withPrefix(pathname, defaultPrefix));
}

const localeOptions: PublicFetchOptions = {
  ...fetchOptions,
  locale: route.locale,
};

const [data, found] = await Promise.all([
  route.locale === base.locale ? base : getPublicSite(localeOptions),
  getPublicDoc(route.path, localeOptions),
]);

const prefix = localePrefix(route.locale, data.site);
Astro.locals.locale = route.locale;
Astro.locals.prefix = prefix;

if (!found) {
  const redirect = findRedirectByFrom(data.redirects, route.path);
  const destination = redirect
    ? redirectDestinationIfValid(redirect, pathname, prefix)
    : undefined;

  if (destination) {
    return Astro.redirect(destination);
  }

  Astro.response.status = 404;
}

// hreflang: the locales this doc is published in, in the site's order.
const alternates =
  found && isMultiLocale(data.site)
    ? (() => {
        const published = data.site.locales.filter((locale) =>
          found.availableLocales.includes(locale),
        );
        const hrefFor = (locale: string) =>
          new URL(
            withPrefix(route.path, localePrefix(locale, data.site)),
            Astro.url.origin,
          ).href;
        const list = published.map((locale) => ({
          hreflang: locale,
          href: hrefFor(locale),
        }));
        if (published.includes(data.site.defaultLocale)) {
          list.push({
            hreflang: 'x-default',
            href: hrefFor(data.site.defaultLocale),
          });
        }
        return list;
      })()
    : [];

const page = found?.collection === 'pages' ? found.doc : undefined;
const docTitle = found?.doc.title ?? undefined;

const title = found
  ? docTitle ?? data.site.name
  : `${data.site.name} — Not found`;
---

<Base
  title={title}
  nav={data.nav}
  footer={data.footer}
  origin={PAYLOAD_URL}
  isHomepage={page?.isHomepage === true}
  lang={route.locale}
  alternates={alternates}
>
  {
    page && (
      <>
        <Hero hero={page.hero} origin={PAYLOAD_URL} />
        <RenderBlocks blocks={page.layout} origin={PAYLOAD_URL} />
      </>
    )
  }
  {found && !page && <h1>{docTitle}</h1>}
  {
    !found && (
      <>
        <h1>Not found</h1>
        <p>The page you requested could not be found.</p>
      </>
    )
  }
</Base>
