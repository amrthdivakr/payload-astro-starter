---
import { PAYLOAD_URL } from 'astro:env/server';
import { getPublicSite } from '../lib/payload';
import type { PublicPage } from '../lib/payload';
import {
  findPageByPath,
  findRedirectByFrom,
  normalizePath,
  redirectDestinationIfValid,
} from '../lib/match';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import RenderBlocks from '../blocks/RenderBlocks.astro';

const previewActive = Astro.cookies.get('payload-preview')?.value === '1';
const previewToken = Astro.cookies.get('payload-token')?.value ?? '';
const inPreview = previewActive && previewToken.length > 0;

const data = inPreview
  ? await getPublicSite({ draft: true, token: previewToken })
  : await getPublicSite();

if (inPreview) {
  Astro.cache.set(false);
} else {
  Astro.cache.set({ maxAge: 3600, tags: ['payload'] });
}

const pathname = normalizePath(Astro.url.pathname);

let title: string;
let heading: string;
let bodyMessage: string | null = null;
let page: PublicPage | undefined;

if (data.pages.length === 0) {
  title = data.site.name;
  heading = data.site.name;
  bodyMessage = 'This site is not published yet.';
} else {
  const matched = findPageByPath(data.pages, pathname);

  if (matched) {
    page = matched;
    title = matched.title;
    heading = matched.title;
  } else {
    const redirect = findRedirectByFrom(data.redirects, pathname);
    const destination = redirect
      ? redirectDestinationIfValid(redirect, data.pages, pathname)
      : undefined;

    if (destination) {
      return Astro.redirect(destination);
    }

    Astro.response.status = 404;
    title = `${data.site.name} — Not found`;
    heading = 'Not found';
    bodyMessage = 'The page you requested could not be found.';
  }
}
---

<Base
  title={title}
  nav={data.nav}
  footer={data.footer}
  pages={data.pages}
  origin={PAYLOAD_URL}
>
  <h1>{heading}</h1>
  {
    page && (
      <>
        <Hero hero={page.hero} pages={data.pages} origin={PAYLOAD_URL} />
        <RenderBlocks
          blocks={page.layout}
          pages={data.pages}
          origin={PAYLOAD_URL}
        />
      </>
    )
  }
  {bodyMessage && <p>{bodyMessage}</p>}
</Base>
