---
import { PAYLOAD_URL } from 'astro:env/server';
import { getPublicSite } from '../lib/payload';
import {
  findPageByPath,
  findRedirectByFrom,
  normalizePath,
  redirectDestinationIfValid,
} from '../lib/match';
import {
  hrefFromLink,
  lexicalToHtml,
  linkLabel,
  mediaUrl,
  parseHero,
} from '../lib/content';

const data = await getPublicSite();
const pathname = normalizePath(Astro.url.pathname);

let title: string;
let heading: string;
let bodyMessage: string | null = null;
let heroHtml = '';
let heroMediaSrc: string | undefined;
let heroMediaAlt = '';
let heroLinkHref: string | undefined;
let heroLinkText: string | undefined;

if (data.pages.length === 0) {
  title = data.site.name;
  heading = data.site.name;
  bodyMessage = 'This site is not published yet.';
} else {
  const page = findPageByPath(data.pages, pathname);

  if (page) {
    title = page.title;
    heading = page.title;

    const hero = parseHero(page.hero);
    if (hero) {
      heroHtml = lexicalToHtml(hero.content);

      const firstMedia = hero.media?.[0];
      if (firstMedia && typeof firstMedia === 'object') {
        const src = mediaUrl(firstMedia, PAYLOAD_URL);
        if (src) {
          heroMediaSrc = src;
          heroMediaAlt =
            typeof firstMedia.alt === 'string' ? firstMedia.alt : '';
        }
      }

      const firstLink = hero.links?.[0];
      if (firstLink) {
        const href = hrefFromLink(firstLink, data.pages);
        if (href) {
          heroLinkHref = href;
          heroLinkText = linkLabel(firstLink) ?? href;
        }
      }
    }
  } else {
    const redirect = findRedirectByFrom(data.redirects, pathname);
    const destination = redirect
      ? redirectDestinationIfValid(redirect, data.pages, pathname)
      : undefined;

    if (destination) {
      return Astro.redirect(destination);
    }

    Astro.response.status = 404;
    title = `${data.site.name} — Not found`;
    heading = 'Not found';
    bodyMessage = 'The page you requested could not be found.';
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <h1>{heading}</h1>
    {heroHtml && <div set:html={heroHtml} />}
    {heroMediaSrc && <img src={heroMediaSrc} alt={heroMediaAlt} />}
    {heroLinkHref && <a href={heroLinkHref}>{heroLinkText}</a>}
    {bodyMessage && <p>{bodyMessage}</p>}
  </body>
</html>
